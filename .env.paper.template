# Vorlage fuer .env.paper (Paper-Stack, AP-06 K3).
#
# Der Paper-Stack laeuft parallel zum Live-Stack auf cma-pi-1 (siehe
# docs/runbooks/paper-account-setup.md). Workflow:
#
#   cp .env.paper.template .env.paper
#   # Werte fuer BG_BOOTSTRAP_ADMIN_TOKEN und BG_PAPER_ACCOUNT_ID
#   # eintragen, dann:
#   ./ops/build-gateway.sh --env=paper
#
# Niemals reale Tokens einchecken - .env.paper steht in .gitignore.

# ---------------------------------------------------------------------------
# Pflicht-Variablen (vor dem ersten Start setzen)
# ---------------------------------------------------------------------------

# Stack-Kennung (Pflicht). Aktiviert die paper-spezifischen Hard-Guards
# und lockert die Validation fuer BG_PAPER_AUTO_LOGIN. Werte: live | paper.
BG_STACK_KIND=paper

# Admin-Bootstrap-Token (admin:* Scope) fuer den Paper-Stack. Eigener
# Wert, NICHT vom Live-Stack uebernehmen. Generieren via:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BG_BOOTSTRAP_ADMIN_TOKEN=

# Paper-Account-ID (DU-Praefix). Wird von tests_paper/_dsl/safety.py
# gegen eine Whitelist gecheckt - nur Konten mit Praefix DU sind
# Paper-Konten. HIER EINTRAGEN, sonst lehnt der Test-Harness alle
# Aufrufe ab.
BG_PAPER_ACCOUNT_ID=DUxxxxxx

# ---------------------------------------------------------------------------
# Stack-Config (paper-spezifisch)
# ---------------------------------------------------------------------------

# Paper-Stack hat einen eigenen CP-Gateway-Container (Compose-Project
# broker-gateway-paper). Default zeigt auf den internen Service-Namen
# im Compose-Netzwerk.
BG_CP_BASE_URL=http://cpgateway:5000/v1/api

# Tickle-Intervall in Sekunden. Default 60.
BG_CP_TICKLE_INTERVAL_S=60

# Quotes-Quelle. Paper bleibt auf polling - der WS-Pfad ist nur fuer
# Live (AP-11 K9). Wer ws auch im Paper-Stack testen will, setzt
# BG_QUOTES_SOURCE=ws; rechnet aber damit, dass Reconnect-Verhalten
# noch nicht laufzeit-validiert ist.

# Recording-Verzeichnis fuer den CP-Wire-Log (AP-05 K3). Im Paper-
# Stack getrennt vom Live-Stack, sodass Recordings nicht mischen.
BG_CP_RECORD_DIR=/var/recordings/paper

# ---------------------------------------------------------------------------
# Auto-Login (Phase A skeleton, Phase B liefert den Sidecar)
# ---------------------------------------------------------------------------

# Master-Schalter fuer den Paper-Auto-Login-Sidecar. Default 0
# (deaktiviert). Auf 1 setzen aktiviert den Trigger im Lifecycle.
# Hard-Guard 1: in Kombination mit BG_STACK_KIND=live ist 1 ein
# Startup-Fail.
BG_PAPER_AUTO_LOGIN=0

# Paper-Login-Credentials. NIEMALS in eine .env auf dem Laptop
# einchecken; auf dem Pi legt der Operator die Werte in
# /etc/default/broker-gateway-paper (Mode 0600 root:root) und der
# build-gateway.sh-Pfad reicht sie als Env weiter. Wenn
# BG_PAPER_AUTO_LOGIN=1 gesetzt ist UND einer der beiden Werte fehlt,
# bricht der Service mit Startup-Fail ab (besser als stiller Skip).
# BG_PAPER_USERNAME=cborlm399
# BG_PAPER_PASSWORD=

# ---------------------------------------------------------------------------
# TWS-Backend (Karten 4 + 5: gnzsnz/ib-gateway statt cpgateway)
# ---------------------------------------------------------------------------

# Aktivierung: ./ops/build-gateway.sh --env=paper --backend=tws.
# Wenn der Build-Skript --backend=tws bekommt, zieht er compose.tws.yaml
# mit und der gateway-Service spricht den tws-Service via TWS-Socket-API
# statt cpgateway via HTTP an (BG_BACKEND=tws aktiviert TWSLifecycle in
# src/broker_gateway/main.py).

# Login-Credentials fuer den gnzsnz/ib-gateway-Container. Selbe Werte
# wie BG_PAPER_USERNAME/_PASSWORD; doppelt benannt, weil cp und tws
# unterschiedliche Service-Namen mappen und die Trennung erlaubt, in
# einer Migrations-Phase beide Stacks parallel zu betreiben.
# BG_TWS_USERNAME=cborlm399
# BG_TWS_PASSWORD=

# paper | live - schaltet den IB-Gateway-Container in den passenden
# IBKR-Modus. Default paper.
# BG_TWS_TRADING_MODE=paper

# Heartbeat-Intervall des TWSLifecycle in Sekunden. Default 60.
# BG_TWS_HEARTBEAT_SEC=60

# Notfall-VNC-Passwort fuer den gnzsnz-Container (Port 5905 auf dem
# Pi-Host, loopback-only). Leer lassen wenn kein VNC noetig ist.
# BG_TWS_VNC_PASSWORD=

# ---------------------------------------------------------------------------
# Test-Harness-Schalter (AP-07/AP-08)
# ---------------------------------------------------------------------------

# Kill-Switch fuer den Paper-Test-Harness (AP-07). Wenn true, lehnt
# der DSL-Sicherheits-Layer (tests_paper/_dsl/safety.py) ALLE
# place/cancel/flatten/subscribe-Calls ab - der Stack laeuft, aber
# Tests sind faktisch read-only. Default false (Tests duerfen
# Operationen ausfuehren).
BG_PAPER_TESTS_DISABLED=false

# ---------------------------------------------------------------------------
# Compose-Wiring (Defaults, ueblicherweise nicht aendern)
# ---------------------------------------------------------------------------

# Werden vom build-gateway.sh --env=paper-Pfad gesetzt; hier nur als
# Referenz, falls die Datei direkt mit `docker compose --env-file
# .env.paper` benutzt wird.
BG_GATEWAY_HOST_PORT=4001
BG_CPGATEWAY_VOLUME=/mnt/ssd/broker-gateway-paper/var/cpgateway-paper/logs

# Pi-Desktop Quick-Login: cpgateway-Port-Bind auf dem Host. Paper
# nutzt 5001, damit Live (5000) und Paper (5001) parallel ohne
# Konflikt erreichbar sind. Bind-Adresse 127.0.0.1 ist in compose.yaml
# fest verdrahtet — siehe docs/runbooks/cpgateway-pi-desktop-login.md.
BG_CPGATEWAY_HOST_PORT=5001

# UID/GID-Override siehe .env.live.template.
# CPGW_UID=1000
# CPGW_GID=1000
