# Vorlage fuer .env.paper (Paper-Stack, AP-06 K3).
#
# Der Paper-Stack laeuft parallel zum Live-Stack auf cma-pi-1 (siehe
# docs/runbooks/paper-account-setup.md). Workflow:
#
#   cp .env.paper.template .env.paper
#   # Werte fuer BG_BOOTSTRAP_ADMIN_TOKEN und BG_PAPER_ACCOUNT_ID
#   # eintragen, dann:
#   ./ops/build-gateway.sh --env=paper
#
# Niemals reale Tokens einchecken - .env.paper steht in .gitignore.

# ---------------------------------------------------------------------------
# Pflicht-Variablen (vor dem ersten Start setzen)
# ---------------------------------------------------------------------------

# Admin-Bootstrap-Token (admin:* Scope) fuer den Paper-Stack. Eigener
# Wert, NICHT vom Live-Stack uebernehmen. Generieren via:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BG_BOOTSTRAP_ADMIN_TOKEN=

# Paper-Account-ID (DU-Praefix). Wird von tests_paper/_dsl/safety.py
# gegen eine Whitelist gecheckt - nur Konten mit Praefix DU sind
# Paper-Konten. HIER EINTRAGEN, sonst lehnt der Test-Harness alle
# Aufrufe ab.
BG_PAPER_ACCOUNT_ID=DUxxxxxx

# ---------------------------------------------------------------------------
# Stack-Config (paper-spezifisch)
# ---------------------------------------------------------------------------

# Paper-Stack hat einen eigenen CP-Gateway-Container (Compose-Project
# broker-gateway-paper). Default zeigt auf den internen Service-Namen
# im Compose-Netzwerk.
BG_CP_BASE_URL=http://cpgateway:5000/v1/api

# Tickle-Intervall in Sekunden. Default 60.
BG_CP_TICKLE_INTERVAL_S=60

# Quotes-Quelle. Paper bleibt auf polling - der WS-Pfad ist nur fuer
# Live (AP-11 K9). Wer ws auch im Paper-Stack testen will, setzt
# BG_QUOTES_SOURCE=ws; rechnet aber damit, dass Reconnect-Verhalten
# noch nicht laufzeit-validiert ist.

# Recording-Verzeichnis fuer den CP-Wire-Log (AP-05 K3). Im Paper-
# Stack getrennt vom Live-Stack, sodass Recordings nicht mischen.
BG_CP_RECORD_DIR=/var/recordings/paper

# ---------------------------------------------------------------------------
# Test-Harness-Schalter (AP-07/AP-08)
# ---------------------------------------------------------------------------

# Kill-Switch fuer den Paper-Test-Harness (AP-07). Wenn true, lehnt
# der DSL-Sicherheits-Layer (tests_paper/_dsl/safety.py) ALLE
# place/cancel/flatten/subscribe-Calls ab - der Stack laeuft, aber
# Tests sind faktisch read-only. Default false (Tests duerfen
# Operationen ausfuehren).
BG_PAPER_TESTS_DISABLED=false

# ---------------------------------------------------------------------------
# Compose-Wiring (Defaults, ueblicherweise nicht aendern)
# ---------------------------------------------------------------------------

# Werden vom build-gateway.sh --env=paper-Pfad gesetzt; hier nur als
# Referenz, falls die Datei direkt mit `docker compose --env-file
# .env.paper` benutzt wird.
BG_GATEWAY_HOST_PORT=4001
BG_CPGATEWAY_VOLUME=/mnt/ssd/broker-gateway-paper/var/cpgateway-paper/logs

# UID/GID-Override siehe .env.live.template.
# CPGW_UID=1000
# CPGW_GID=1000
