# Vorlage fuer /etc/default/broker-gateway-watchdog (Karte 53c10ff4).
# Auf cma-pi-1 installieren - NICHT ins Repo committen (das ntfy-Topic ist
# semi-geheim: wer den Namen kennt, kann Push-Nachrichten lesen UND senden).
#
#   sudo install -m 0640 -o cma -g cma /dev/null /etc/default/broker-gateway-watchdog
#   sudoedit /etc/default/broker-gateway-watchdog
#   # Inhalt dieser Datei uebernehmen, Topic mit Zufallssuffix einsetzen.

# Pflicht: ntfy-Topic-URL fuer den Push-Alarm aufs Handy. Ein schwer
# erratbares Topic waehlen (Zufallssuffix), da ntfy.sh-Topics oeffentlich
# adressierbar sind. Auf dem Handy die ntfy-App installieren und genau
# dieses Topic abonnieren.
BG_WATCHDOG_NTFY_URL=https://ntfy.sh/broker-gateway-tws-CHANGEME

# Optional - die Defaults im Skript sind sinnvoll:
# BG_WATCHDOG_DOWN_THRESHOLD=2     # konsekutive 15-min-Laeufe vor Alarm (~30 min)
# BG_WATCHDOG_REALERT_HOURS=6      # erneuter Alarm fruehestens nach N Stunden
# BG_WATCHDOG_STATE_FILE=/var/lib/broker-gateway/tws-watchdog-state.json
