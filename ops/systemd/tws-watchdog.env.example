# Vorlage fuer /etc/default/broker-gateway-watchdog (Karte 53c10ff4).
# Auf cma-pi-1 installieren - NICHT ins Repo committen (das ntfy-Topic ist
# semi-geheim: wer den Namen kennt, kann Push-Nachrichten lesen UND senden).
#
#   sudo install -m 0640 -o cma -g cma /dev/null /etc/default/broker-gateway-watchdog
#   sudoedit /etc/default/broker-gateway-watchdog
#   # Inhalt dieser Datei uebernehmen, Topic mit Zufallssuffix einsetzen.

# Pflicht: ntfy-Topic-URL fuer den Push-Alarm aufs Handy. Ein schwer
# erratbares Topic waehlen (Zufallssuffix), da ntfy.sh-Topics oeffentlich
# adressierbar sind. Auf dem Handy die ntfy-App installieren und genau
# dieses Topic abonnieren.
BG_WATCHDOG_NTFY_URL=https://ntfy.sh/broker-gateway-tws-CHANGEME

# Optional - die Defaults im Skript sind sinnvoll:
# BG_WATCHDOG_DOWN_THRESHOLD=2     # konsekutive 15-min-Laeufe vor Alarm (~30 min)
# BG_WATCHDOG_REALERT_HOURS=6      # erneuter Alarm fruehestens nach N Stunden
# BG_WATCHDOG_STATE_FILE=/var/lib/broker-gateway/tws-watchdog-state.json

# --- Remote-Restart-Loop (tws-command-listener.service, Karte a529e59a) ------
# Der Listener abonniert ein Command-Topic und loest nach einem
# Bestaetigungs-Round-Trip (One-Time-Nonce) genau EINEN Live-tws-force-recreate
# aus. Die eigentliche 2FA bleibt der IB-Key-Tap am Handy.
#
# Pflicht: das Command-Topic, auf dem der Listener 'recreate-live' und
# 'confirm <nonce>' empfaengt. Es MUSS ein ANDERES, ebenfalls schwer
# erratbares Topic sein als das Status/Alarm-Topic - beide sind auf ntfy.sh
# oeffentlich; die Trennung + Zufallssuffix erschwert Mitlesen/Missbrauch
# (Bedrohungsmodell siehe docs/04-security.md).
BG_CMD_COMMAND_TOPIC_URL=https://ntfy.sh/broker-gateway-cmd-CHANGEME

# Status-Topic fuer die Rueckmeldungen des Listeners (Nonce-Prompt,
# Fortschritt, Ergebnis). In der Regel identisch mit dem Watchdog-Alarm-Topic
# oben - dort ist der Operator schon subscribed.
BG_CMD_STATUS_TOPIC_URL=https://ntfy.sh/broker-gateway-tws-CHANGEME

# Optional - die Defaults im Skript sind sinnvoll:
# BG_CMD_CONFIRM_TTL_S=120           # Gueltigkeit eines Bestaetigungs-Nonce (s)
# BG_CMD_COOLDOWN_S=300              # Sperre fuer weitere Trigger nach Recreate (s).
#                                      Sollte >= BG_CMD_HEALTH_WAIT_S bleiben, sonst
#                                      kann direkt nach dem Health-Poll ein zweiter
#                                      Trigger feuern (konkurrierende 2FA-Pushes).
# BG_CMD_HEALTH_WAIT_S=180           # max. Wartezeit auf tws=healthy nach Recreate (s)
# BG_CMD_HEALTH_POLL_INTERVAL_S=10   # Poll-Intervall der Health-Pruefung (s)
# BG_CMD_TWS_CONTAINER=broker-gateway-tws
# BG_LIVE_REPO_DIR=/mnt/ssd/broker-gateway  # an recreate-tws-live.sh durchgereicht
