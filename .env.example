# Vorlage fuer .env (nicht eingecheckt, wird per docker compose env_file geladen).
#
# Beim ersten Setup auf einem neuen Host:
#   cp .env.example .env
#   python3 -c 'import secrets; print("BG_BOOTSTRAP_ADMIN_TOKEN=" + secrets.token_urlsafe(32))' >> .env
#   sed -i '/^BG_BOOTSTRAP_ADMIN_TOKEN=$/d' .env
# Dann compose-Stack neu starten.
#
# Niemals den realen .env-Inhalt einchecken - die Datei steht in .gitignore.

# Admin-Bootstrap-Token (admin:* Scope) - initialer Einstiegspunkt fuer die
# Token-Verwaltung. Ohne diesen Wert kann der Service zwar starten und
# /v1/health beantworten, aber keine geschuetzten Endpunkte (inkl.
# /v1/internal/health) bedienen. Empfohlen: secrets.token_urlsafe(32).
BG_BOOTSTRAP_ADMIN_TOKEN=

# Optional: Override der CP-Gateway-Base-URL. Default reicht im Compose-Stack.
# BG_CP_BASE_URL=http://cpgateway:5000

# Optional: Tickle-Intervall in Sekunden. Default 60.
# BG_CP_TICKLE_INTERVAL_S=60

# Quotes-Quelle fuer /v1/quotes/stream (AP-11 K3).
#   polling  - REST-Polling gegen /iserver/marketdata/snapshot (Bestand,
#              Phase A Default solange WSPushSource live nicht
#              verifiziert ist)
#   ws       - WSPushSource: smd-WS-Frames durch SmdTopicAdapter, Quotes
#              fliessen ueber SubscriptionManager.publish in den
#              bestehenden Refcount-/Fan-Out-Pfad. Last-Event-ID-Replay,
#              Heartbeat und Frame-Schema bleiben identisch zum Polling.
# Wechsel auf ws im Live-Konto erst, nachdem ein voller Trading-Tag
# gegen U25235077 stabil lief; Rollback per Aenderung dieses Werts.
# BG_QUOTES_SOURCE=polling

# UID/GID, mit denen der cpgateway-Container den Service-User cpgw anlegt.
# Match an den Host-User, der das logs-Volume besitzen soll (auf cma-pi-1
# ist das cma -> 1000). Pruefen via: id cma. Default ist 1000 - nur setzen,
# wenn der Host eine andere UID/GID hat.
# CPGW_UID=1000
# CPGW_GID=1000

# ---------------------------------------------------------------------------
# TWS-Container (Karte 8b1781d3, Image ghcr.io/gnzsnz/ib-gateway:10.45.1e)
# ---------------------------------------------------------------------------
# Pflicht, wenn der tws-Service hochkommen soll. Username/Password
# auf dem Pi via /etc/default/broker-gateway{,-paper} (Mode 0600); hier
# nur dokumentiert.
# TWS_USERID=
# TWS_PASSWORD=

# Host-Port-Bind fuer den TWS-Container. Default je nach Stack-Kind:
#   live  -> BG_TWS_HOST_PORT=4101 (Container-intern 4001)
#   paper -> BG_TWS_HOST_PORT=4102 (Container-intern 4002)
# 4001/4002 direkt am Host kollidieren mit dem Paper-Gateway-Host-Port.
# BG_TWS_HOST_PORT=

# ReadOnlyApi-Default. yes blockt Order-Submit auf API-Ebene; auf no
# flippen erst nach Cutover (Karte 5/6).
# TWS_READ_ONLY_API=yes

# Optional: TRADING_MODE, AUTO_RESTART_TIME, TIME_ZONE - Defaults stehen
# in compose.yaml und passen i.d.R. ohne Override.
# BG_TRADING_MODE=paper
# AUTO_RESTART_TIME=11:59 PM
# TWS_TIME_ZONE=Europe/Vienna
