# IBKR Client Portal Gateway als interner Service des broker-gateway-Stacks.
#
# Der Tarball clientportal.gw.tar.gz wird separat von IBKR bezogen und liegt
# neben diesem Dockerfile im Build-Context (ops/cpgateway/). Er ist
# .gitignored und wird nicht eingecheckt — siehe ops/cpgateway/README.md.
FROM eclipse-temurin:21-jre-noble

# Pfad zum IBKR-Tarball, relativ zum Build-Context (ops/cpgateway/).
# Override per --build-arg moeglich, falls eine alternative Kopie genutzt
# werden soll (z.B. ein gepinntes Archiv aus einem internen Mirror).
ARG CPGW_TARBALL=clientportal.gw.tar.gz

# UID/GID des Container-Users cpgw. Defaults entsprechen dem cma-User auf
# cma-pi-1 (id cma -> 1000:1000). Auf Hosts mit anderem User-Mapping per
# --build-arg ueberschreiben (compose.yaml liest CPGW_UID/CPGW_GID aus dem
# Environment / .env). Match ist wichtig, weil das Volume
# ./var/cpgateway/logs:/opt/clientportal.gw/logs sonst Logs mit einem im
# Host nicht existierenden Owner schreibt.
ARG CPGW_UID=1000
ARG CPGW_GID=1000

# curl wird vom compose-Healthcheck gegen http://localhost:5000/v1/api/one/user
# gebraucht. tar + sha256sum sind im Base-Image bereits vorhanden.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dedizierten Service-User anlegen (kein Login-Shell, kein Home jenseits
# von /opt/clientportal.gw) und gleich GID/UID festziehen. Das Base-Image
# eclipse-temurin:21-jre-noble liefert einen Default-User ubuntu mit
# UID/GID 1000 mit - der muss weichen, damit wir die UID frei zuordnen
# koennen (sonst "useradd: UID 1000 already exists", Build-Exit 4).
RUN if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu 2>/dev/null || userdel ubuntu; fi \
    && if getent group ubuntu >/dev/null 2>&1; then groupdel ubuntu; fi \
    && groupadd --system --gid ${CPGW_GID} cpgw \
    && useradd --system --uid ${CPGW_UID} --gid cpgw \
        --home /opt/clientportal.gw --shell /usr/sbin/nologin cpgw

WORKDIR /opt/clientportal.gw

# Tarball validieren, entpacken, conf.yaml ueberschreiben. SHA256-Check ist
# strikt: schlaegt er fehl, scheitert der Build (kein --skip).
COPY ${CPGW_TARBALL} /tmp/clientportal.gw.tar.gz
COPY clientportal.gw.tar.gz.sha256 /tmp/clientportal.gw.tar.gz.sha256
RUN cd /tmp \
    && sha256sum -c clientportal.gw.tar.gz.sha256 \
    && tar -xzf /tmp/clientportal.gw.tar.gz -C /opt/clientportal.gw \
    && rm /tmp/clientportal.gw.tar.gz /tmp/clientportal.gw.tar.gz.sha256

COPY conf.yaml /opt/clientportal.gw/root/conf.yaml

# Logs schreibt das CP-Gateway nach /opt/clientportal.gw/logs/. Dieses
# Verzeichnis wird per compose.yaml als Volume nach ./var/cpgateway/logs
# auf dem Host gemountet - Owner muss cpgw sein, damit Logs als
# cma:cma (= UID 1000:1000) auf dem Host landen.
RUN mkdir -p /opt/clientportal.gw/logs \
    && chown -R cpgw:cpgw /opt/clientportal.gw

USER cpgw

EXPOSE 5000

CMD ["bin/run.sh", "root/conf.yaml"]
